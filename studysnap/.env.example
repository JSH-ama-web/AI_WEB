# 이 파일을 복사해 .env.local 로 만들고 실제 값을 넣으세요. (.env.local 은 Git에 올라가지 않습니다)
# 코디세이 콘솔(https://copa.codyssey.kr)에서 발급/확인한 값
AI_API_KEY=여기에_본인_키_입력
AI_BASE_URL=여기에_콘솔에_안내된_Gateway_주소_입력
# 선택: 모델 이름 (기본값 claude-haiku-5-5, 콘솔에서 사용 가능한 이름 확인)
AI_MODEL=claude-haiku-5-5
# 선택: anthropic(기본) 또는 openai
AI_API_FORMAT=anthropic
